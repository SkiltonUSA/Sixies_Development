!source "src/generated/transition_backdrop.inc"

* = squares_charset_base
!bin "src/assets/transitionsquares_charset.bin"
!fill 8, 0

* = scattered_charset_base
!bin "src/assets/transitionscattered_charset.bin"
!fill 8, 0

