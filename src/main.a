* = $c000
starwars_bootstrap:
    sei
    lda #$00
    sta $d01a
    sta $d015
    lda #$7f
    sta $dc0d
    sta $dd0d
    lda $dc0d
    lda $dd0d
    lda #$37
    sta $01
    cli

    lda #$01
    sta star_load_step
    lda #boot_swcode_name_end - boot_swcode_name
    ldx #<boot_swcode_name
    ldy #>boot_swcode_name
    jsr starwars_boot_load

    inc star_load_step
    lda #boot_swscreen_name_end - boot_swscreen_name
    ldx #<boot_swscreen_name
    ldy #>boot_swscreen_name
    jsr starwars_boot_load

    inc star_load_step
    lda #boot_swfont_name_end - boot_swfont_name
    ldx #<boot_swfont_name
    ldy #>boot_swfont_name
    jsr starwars_boot_load

    inc star_load_step
    lda #boot_swtext_name_end - boot_swtext_name
    ldx #<boot_swtext_name
    ldy #>boot_swtext_name
    jsr starwars_boot_load

    inc star_load_step
    lda #boot_swsprites_name_end - boot_swsprites_name
    ldx #<boot_swsprites_name
    ldy #>boot_swsprites_name
    jsr starwars_boot_load

    inc star_load_step
    lda #boot_swbase_name_end - boot_swbase_name
    ldx #<boot_swbase_name
    ldy #>boot_swbase_name
    jsr starwars_boot_load

    inc star_load_step
    lda #boot_swmusic_name_end - boot_swmusic_name
    ldx #<boot_swmusic_name
    ldy #>boot_swmusic_name
    jsr starwars_boot_load

    inc star_load_step
    lda #boot_swdisk_name_end - boot_swdisk_name
    ldx #<boot_swdisk_name
    ldy #>boot_swdisk_name
    jsr starwars_boot_load

    sei
    lda #$00
    sta $fe
    sta $ff
    sta $088f       ; PartDone
    sta $08ff       ; full-demo marker: clear = standalone, scroll loops forever
    jsr $0900
    lda $dd00
    and #%11111100
    sta $dd00
    lda #$3f
    sta $dd02
    lda #<starwars_nmi_rti
    sta $fffa
    lda #>starwars_nmi_rti
    sta $fffb
    lda #$35
    sta $01

    ; Phase-lock CIA2 Timer B to the raster (63 cycles per line).
    ; The part's stable-raster IRQs read $dd06 for jitter compensation;
    ; in the original demo this is done by Entry.prg (PreDemoSetup,
    ; borrowed from Spindle by lft).
starwars_timerb_vblank:
    bit $d011
    bmi starwars_timerb_vblank
starwars_timerb_wait:
    bit $d011
    bpl starwars_timerb_wait
    ldx $d012
    inx
starwars_timerb_resync:
    cpx $d012
    bne starwars_timerb_resync
    ldy #$00
    sty $dd07
    lda #62
    sta $dd06
    iny
    sty $d01a
    dey
    dey
    sty $dc02
    cmp ($00,x)
    cmp ($00,x)
    cmp ($00,x)
    lda #$11
    sta $dd0f
    txa
    inx
    inx
    cmp $d012
    bne starwars_timerb_resync

    jsr STARWARS_GO
    lda #$37
    sta $01
    jmp ($fffc)

starwars_nmi_rti:
    rti

starwars_boot_load:
    jsr KERNAL_SETNAM
    lda #$01
    ldx #$08
    ldy #$01
    jsr KERNAL_SETLFS
    lda #$00
    tax
    tay
    jsr KERNAL_LOAD
    bcs starwars_boot_error
    rts

starwars_boot_error:
    lda #$02
    sta $d020
    lda star_load_step
    sta $d021
starwars_boot_error_loop:
    jmp starwars_boot_error_loop

boot_swcode_name:
!text "SWCODE"
boot_swcode_name_end:
boot_swscreen_name:
!text "SWSCREEN"
boot_swscreen_name_end:
boot_swfont_name:
!text "SWFONT"
boot_swfont_name_end:
boot_swtext_name:
!text "SWTEXT"
boot_swtext_name_end:
boot_swsprites_name:
!text "SWSPRITES"
boot_swsprites_name_end:
boot_swbase_name:
!text "SWBASE"
boot_swbase_name_end:
boot_swmusic_name:
!text "SWMUSIC"
boot_swmusic_name_end:
boot_swdisk_name:
!text "SWDISK"
boot_swdisk_name_end:
