; Starwars Demo -- bitmap perspective scroller intro.
; Technique ported from the NoBounds public release (Starwars.cpp/.asm)
; and https://c64demo.com/star-wars-scrollers/:
;   - hires bitmap, background = 1-bits, ink = 0-bits (glyphs AND together)
;   - 16 cyclic 256-byte column buffers of font-row indices
;   - generated unrolled plotter with perspective bit-picked FontData

!ifdef SPARKLE_PAYLOAD {
    !to "build/StarwarsScrollerDemo-sparkle-part.prg", cbm
} else {
    !to "build/StarwarsScrollerDemo.prg", cbm
}

SCREEN = $c000                  ; VIC bank 3, screen offset $0000
BITMAP = $e000                  ; VIC bank 3, bitmap offset $2000
SCREENFADEBOBS_CHARSET = $c800  ; VIC bank 3, charset offset $0800
SCREENFADEBOBS_FRAMES = 70      ; one silent pre-roll before bitmap mode starts
SCROLL_DATA = $7800             ; 16 pages, CPU-only (VIC never reads these)
LOGO_BYTES = 3200               ; 320x80 hires bitmap bytes
LOGO_COLOR_BYTES = 400          ; 40x10 screen colour bytes

text_ptr = $fb
row_counter = $02
col_save = $03
tmp = $04
logo_src = $05
logo_dst = $07

; The exported char-mode fade lives in the same VIC bank as the bitmap part so
; no bank switch is required between the intro and the crawl.
screenfadebobs_screen_base = SCREEN
screenfadebobs_color_base = $d800
screenfadebobs_d018 = $02
screenfadebobs_charset_base = SCREENFADEBOBS_CHARSET
screenfadebobs_dst_ptr = $f9
screenfadebobs_color_ptr = $fb
screenfadebobs_border_color = $00
screenfadebobs_background_color = $00
screenfadebobs_multi1_color = $0c
screenfadebobs_multi2_color = $01
screenfadebobs_bob_color = $0f

!ifndef SPARKLE_PAYLOAD {
    * = $0801
    !byte $0c,$08,$0a,$00,$9e
    !text "2061"
    !byte $00,$00,$00
}

* = $080d
entry:
    sei
    ldx #$ff
    txs
    lda #$35                    ; ROMs out, I/O in: init reads RAM at $e000
    sta $01
    lda #$7f
    sta $dc0d
    sta $dd0d
    lda $dc0d
    lda $dd0d
    lda #$00
    sta $d01a
    lda #$ff
    sta $d019

    lda $dd00
    and #$fc                    ; VIC bank 3 ($c000-$ffff)
    sta $dd00
    ; Run the exported char-mode reveal before enabling bitmap mode or music IRQ.
    ; This keeps the loader/direct paths unchanged and leaves the crawl setup
    ; deterministic after the intro completes.
    jsr run_screenfadebobs_intro
    lda #$3b                    ; bitmap mode on
    sta $d011
    lda #$08
    sta $d016
    lda #$08                    ; screen $c000, bitmap $e000
    sta $d018
    lda #$00
    sta $d015
    sta $d020

; bitmap: fill $e000-$ffff with $ff (all background)
    lda #<BITMAP
    sta text_ptr
    lda #>BITMAP
    sta text_ptr+1
    ldx #$20
    lda #$ff
    ldy #$00
clear_bitmap_page:
    sta (text_ptr),y
    iny
    bne clear_bitmap_page
    inc text_ptr+1
    dex
    bne clear_bitmap_page

; screen RAM: one colour byte per char row
    lda #<SCREEN
    sta text_ptr
    lda #>SCREEN
    sta text_ptr+1
    ldx #$00
screen_row_loop:
    lda screen_row_colors,x
    ldy #39
screen_col_loop:
    sta (text_ptr),y
    dey
    bpl screen_col_loop
    lda text_ptr
    clc
    adc #40
    sta text_ptr
    bcc screen_row_next
    inc text_ptr+1
screen_row_next:
    inx
    cpx #25
    bne screen_row_loop

; punch the starfield into the bitmap (0-bit = white pixel)
    ldx #$00
star_loop:
    lda star_lo,x
    clc
    adc #<BITMAP
    sta text_ptr
    lda star_hi,x
    adc #>BITMAP
    sta text_ptr+1
    ldy #$00
    lda star_val,x
    sta (text_ptr),y
    inx
    cpx #STAR_COUNT
    bne star_loop

; AND-merge the Death Star banner above the crawl.  Logo ink is 0-bits so
; stars around the image survive.
    lda #<logo_bitmap
    sta logo_src
    lda #>logo_bitmap
    sta logo_src+1
    lda #<BITMAP
    sta logo_dst
    lda #>BITMAP
    sta logo_dst+1
    ldx #>LOGO_BYTES
    ldy #$00
logo_page_loop:
    lda (logo_src),y
    and (logo_dst),y
    sta (logo_dst),y
    iny
    bne logo_page_loop
    inc logo_src+1
    inc logo_dst+1
    dex
    bne logo_page_loop
!if <LOGO_BYTES != 0 {
logo_tail_loop:
    lda (logo_src),y
    and (logo_dst),y
    sta (logo_dst),y
    iny
    cpy #<LOGO_BYTES
    bne logo_tail_loop
}

; Per-cell foreground colours for the 320x80 banner.
    lda #<logo_colors
    sta logo_src
    lda #>logo_colors
    sta logo_src+1
    lda #<SCREEN
    sta logo_dst
    lda #>SCREEN
    sta logo_dst+1
    ldx #>LOGO_COLOR_BYTES
    ldy #$00
logo_color_page_loop:
    lda (logo_src),y
    sta (logo_dst),y
    iny
    bne logo_color_page_loop
    inc logo_src+1
    inc logo_dst+1
    dex
    bne logo_color_page_loop
!if <LOGO_COLOR_BYTES != 0 {
logo_color_tail_loop:
    lda (logo_src),y
    sta (logo_dst),y
    iny
    cpy #<LOGO_COLOR_BYTES
    bne logo_color_tail_loop
}

; scroll buffers: index 0 = blank font row
    lda #<SCROLL_DATA
    sta text_ptr
    lda #>SCROLL_DATA
    sta text_ptr+1
    ldx #$10
    lda #$00
    tay
clear_scroll_page:
    sta (text_ptr),y
    iny
    bne clear_scroll_page
    inc text_ptr+1
    dex
    bne clear_scroll_page

    lda #$00
    sta row_counter
    lda #<scroll_text
    sta text_ptr
    lda #>scroll_text
    sta text_ptr+1

; Galway Nights soundtrack: the unrolled plotter takes more than one
; frame, so the player is clocked from a raster IRQ instead of the main
; loop. KERNAL is banked in for the $0314 vector; the bitmap at $e000
; is write-only from the CPU so the ROM overlay is harmless.
    lda #$36
    sta $01
    jsr galway_init
    lda #<music_irq
    sta $0314
    lda #>music_irq
    sta $0315
    lda #$10                    ; fire well away from the $f8 frame wait
    sta $d012
    lda $d011
    and #$7f
    sta $d011
    lda #$01
    sta $d01a
    lda #$ff
    sta $d019
    cli

main_loop:
    jsr wait_frame
    jsr plotter
    jsr update_scroll
    jmp main_loop

wait_frame:
wf0:
    lda $d012
    cmp #$f8
    bne wf0
wf1:
    lda $d012
    cmp #$f8
    beq wf1
    rts

run_screenfadebobs_intro:
    jsr screenfadebobs_build_charset
    jsr screenfadebobs_init
    ldx #SCREENFADEBOBS_FRAMES
screenfadebobs_intro_loop:
    jsr wait_frame
    jsr screenfadebobs_update
    dex
    bne screenfadebobs_intro_loop
    rts

music_irq:
    asl $d019                   ; acknowledge the raster interrupt
    jsr galway_play
    jmp $ea81                   ; restore registers and rti

; advance the crawl one source row and stream the next row of text into
; the cyclic column buffers, just below the visible window
update_scroll:
    inc plot_base+1
    lda plot_base+1
    clc
    adc #SCROLL_WINDOW
    tax                         ; x = write position in the cyclic buffers
    ldy row_counter
    cpy #16
    bcs write_gap_row

    lda font_row_lo,y
    sta font_read+1
    lda font_row_hi,y
    sta font_read+2
    lda #>SCROLL_DATA
    sta font_write+2
    ldy #$00
glyph_col_loop:
    lda (text_ptr),y
    sty col_save
    tay
font_read:
    lda remapped_font,y
font_write:
    sta SCROLL_DATA,x
    inc font_write+2
    ldy col_save
    iny
    cpy #16
    bne glyph_col_loop
    inc row_counter
    rts

write_gap_row:
    lda #>SCROLL_DATA
    sta gap_write+2
    ldy #16
    lda #$00
gap_loop:
gap_write:
    sta SCROLL_DATA,x
    inc gap_write+2
    dey
    bne gap_loop

    inc row_counter
    lda row_counter
    cmp #ROWS_PER_TEXT_LINE
    bne update_done
    lda #$00
    sta row_counter
    lda text_ptr                ; next text line
    clc
    adc #16
    sta text_ptr
    bcc check_wrap
    inc text_ptr+1
check_wrap:
    ldy #$00
    lda (text_ptr),y
    cmp #$ff
    bne update_done
    lda #<scroll_text
    sta text_ptr
    lda #>scroll_text
    sta text_ptr+1
update_done:
    rts

!source "src/generated/sw_data.inc"
!source "src/generated/sw_plot.inc"

!if * > SCROLL_DATA {
    !error "program overlaps the scroll buffers at SCROLL_DATA"
}

; Soundtrack and logo live above the scroll buffers, below the VIC bank.
* = $9000
!source "src/generated/galway_nights.inc"
!source "src/music/galway_player.inc"
!source "src/screenfadebobs.inc"
!source "src/generated/logo.inc"

!if * > $c000 {
    !error "music and logo overlap the VIC bank at $c000"
}
