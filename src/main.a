; Bangalore Star Wars scroller intro -- bitmap perspective version.
; Technique ported from the NoBounds public release (StarWars.cpp/.asm)
; and https://c64demo.com/star-wars-scrollers/:
;   - hires bitmap, background = 1-bits, ink = 0-bits (glyphs AND together)
;   - 16 cyclic 256-byte column buffers of font-row indices
;   - generated unrolled plotter with perspective bit-picked FontData

!ifdef SPARKLE_PAYLOAD {
    !to "build/bangalore-sparkle-part.prg", cbm
} else {
    !to "build/bangalore.prg", cbm
}

SCREEN = $c000                  ; VIC bank 3, screen offset $0000
BITMAP = $e000                  ; VIC bank 3, bitmap offset $2000
SCROLL_DATA = $7000             ; 16 pages, CPU-only (VIC never reads these)

text_ptr = $fb
row_counter = $02
col_save = $03
tmp = $04

!ifndef SPARKLE_PAYLOAD {
    * = $0801
    !byte $0c,$08,$0a,$00,$9e
    !text "2061"
    !byte $00,$00,$00
}

* = $080d
entry:
    sei
    ldx #$ff
    txs
    lda #$35                    ; ROMs out, I/O in: init reads RAM at $e000
    sta $01
    lda #$7f
    sta $dc0d
    sta $dd0d
    lda $dc0d
    lda $dd0d
    lda #$00
    sta $d01a
    lda #$ff
    sta $d019

    lda $dd00
    and #$fc                    ; VIC bank 3 ($c000-$ffff)
    sta $dd00
    lda #$3b                    ; bitmap mode on
    sta $d011
    lda #$08
    sta $d016
    lda #$08                    ; screen $c000, bitmap $e000
    sta $d018
    lda #$00
    sta $d015
    sta $d020

; bitmap: fill $e000-$ffff with $ff (all background)
    lda #<BITMAP
    sta text_ptr
    lda #>BITMAP
    sta text_ptr+1
    ldx #$20
    lda #$ff
    ldy #$00
clear_bitmap_page:
    sta (text_ptr),y
    iny
    bne clear_bitmap_page
    inc text_ptr+1
    dex
    bne clear_bitmap_page

; screen RAM: one colour byte per char row
    lda #<SCREEN
    sta text_ptr
    lda #>SCREEN
    sta text_ptr+1
    ldx #$00
screen_row_loop:
    lda screen_row_colors,x
    ldy #39
screen_col_loop:
    sta (text_ptr),y
    dey
    bpl screen_col_loop
    lda text_ptr
    clc
    adc #40
    sta text_ptr
    bcc screen_row_next
    inc text_ptr+1
screen_row_next:
    inx
    cpx #25
    bne screen_row_loop

; punch the starfield into the bitmap (0-bit = white pixel)
    ldx #$00
star_loop:
    lda star_lo,x
    clc
    adc #<BITMAP
    sta text_ptr
    lda star_hi,x
    adc #>BITMAP
    sta text_ptr+1
    ldy #$00
    lda star_val,x
    sta (text_ptr),y
    inx
    cpx #STAR_COUNT
    bne star_loop

; AND-merge the RetroDNA logo into the top four char rows (1280 bytes);
; logo ink is 0-bits so stars around the lettering survive
    ldx #$00
logo_loop:
    lda logo_bitmap,x
    and BITMAP,x
    sta BITMAP,x
    lda logo_bitmap+$100,x
    and BITMAP+$100,x
    sta BITMAP+$100,x
    lda logo_bitmap+$200,x
    and BITMAP+$200,x
    sta BITMAP+$200,x
    lda logo_bitmap+$300,x
    and BITMAP+$300,x
    sta BITMAP+$300,x
    lda logo_bitmap+$400,x
    and BITMAP+$400,x
    sta BITMAP+$400,x
    inx
    bne logo_loop

; per-row logo colours over the 26 columns the lettering spans
    ldx #25
logo_color_loop:
    lda logo_colors+0
    sta SCREEN+0*40+7,x
    lda logo_colors+1
    sta SCREEN+1*40+7,x
    lda logo_colors+2
    sta SCREEN+2*40+7,x
    lda logo_colors+3
    sta SCREEN+3*40+7,x
    dex
    bpl logo_color_loop

; scroll buffers: index 0 = blank font row
    lda #<SCROLL_DATA
    sta text_ptr
    lda #>SCROLL_DATA
    sta text_ptr+1
    ldx #$10
    lda #$00
    tay
clear_scroll_page:
    sta (text_ptr),y
    iny
    bne clear_scroll_page
    inc text_ptr+1
    dex
    bne clear_scroll_page

    lda #$00
    sta row_counter
    lda #<scroll_text
    sta text_ptr
    lda #>scroll_text
    sta text_ptr+1

; Galway Nights soundtrack: the unrolled plotter takes more than one
; frame, so the player is clocked from a raster IRQ instead of the main
; loop. KERNAL is banked in for the $0314 vector; the bitmap at $e000
; is write-only from the CPU so the ROM overlay is harmless.
    lda #$36
    sta $01
    jsr galway_init
    lda #<music_irq
    sta $0314
    lda #>music_irq
    sta $0315
    lda #$10                    ; fire well away from the $f8 frame wait
    sta $d012
    lda $d011
    and #$7f
    sta $d011
    lda #$01
    sta $d01a
    lda #$ff
    sta $d019
    cli

main_loop:
    jsr wait_frame
    jsr plotter
    jsr update_scroll
    jmp main_loop

wait_frame:
wf0:
    lda $d012
    cmp #$f8
    bne wf0
wf1:
    lda $d012
    cmp #$f8
    beq wf1
    rts

music_irq:
    asl $d019                   ; acknowledge the raster interrupt
    jsr galway_play
    jmp $ea81                   ; restore registers and rti

; advance the crawl one source row and stream the next row of text into
; the cyclic column buffers, just below the visible window
update_scroll:
    inc plot_base+1
    lda plot_base+1
    clc
    adc #SCROLL_WINDOW
    tax                         ; x = write position in the cyclic buffers
    ldy row_counter
    cpy #16
    bcs write_gap_row

    lda font_row_lo,y
    sta font_read+1
    lda font_row_hi,y
    sta font_read+2
    lda #>SCROLL_DATA
    sta font_write+2
    ldy #$00
glyph_col_loop:
    lda (text_ptr),y
    sty col_save
    tay
font_read:
    lda remapped_font,y
font_write:
    sta SCROLL_DATA,x
    inc font_write+2
    ldy col_save
    iny
    cpy #16
    bne glyph_col_loop
    inc row_counter
    rts

write_gap_row:
    lda #>SCROLL_DATA
    sta gap_write+2
    ldy #16
    lda #$00
gap_loop:
gap_write:
    sta SCROLL_DATA,x
    inc gap_write+2
    dey
    bne gap_loop

    inc row_counter
    lda row_counter
    cmp #ROWS_PER_TEXT_LINE
    bne update_done
    lda #$00
    sta row_counter
    lda text_ptr                ; next text line
    clc
    adc #16
    sta text_ptr
    bcc check_wrap
    inc text_ptr+1
check_wrap:
    ldy #$00
    lda (text_ptr),y
    cmp #$ff
    bne update_done
    lda #<scroll_text
    sta text_ptr
    lda #>scroll_text
    sta text_ptr+1
update_done:
    rts

!source "src/generated/sw_data.inc"
!source "src/generated/sw_plot.inc"

!if * > SCROLL_DATA {
    !error "program overlaps the scroll buffers at SCROLL_DATA"
}

; Soundtrack and logo live above the scroll buffers, below the VIC bank.
* = $8000
!source "src/generated/galway_nights.inc"
!source "src/music/galway_player.inc"
!source "src/generated/logo.inc"

!if * > $c000 {
    !error "music and logo overlap the VIC bank at $c000"
}
