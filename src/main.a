; Nobounds menu demo
; Sources:
; - XMarksTheSpot/SourceCode/DemoParts/Metalux-Plasma.asm
; - NoBounds/Parts/PlasmaVector/PlasmaVectorIntro.asm
; - NoBounds/Link/PlasmaVector/RazorbackUnbound*
; - NoBounds/Parts/HiresLoader/*
; - NoBounds/Link/StarWars/*

!to "build/dhaka.prg", cbm

mode            = $02
key_code        = $03
key_lock        = $04
frame_counter   = $05
plasma_x_phase  = $06
plasma_y_phase  = $07
menu_pulse      = $08
reveal_step     = $09
effect_timer    = $0a
column_phase    = $0b
column_dir      = $0c
column_left_y   = $0d
column_right_y  = $0e
tmp0            = $0f
tmp1            = $10
tmp2            = $11
row_counter     = $12
star_index      = $13
star_tick       = $14
razor_phase     = $15
star_load_step  = $16
scr_ptr         = $fb
col_ptr         = $fd
txt_ptr         = $f9

KERNAL_SETLFS   = $ffba
KERNAL_SETNAM   = $ffbd
KERNAL_CLOSE    = $ffc3
KERNAL_CLRCHN   = $ffcc
KERNAL_LOAD     = $ffd5

MODE_MENU       = $00
MODE_METALUX    = $01
MODE_PV_FADE    = $02
MODE_BITMAP     = $03
MODE_HIRES      = $04
MODE_RAZOR_PLASMA = $05
MODE_STARWARS   = $06
RAZOR_PLASMA_COLS = 18
RAZOR_PLASMA_MAP_TAIL = 320 - (RAZOR_PLASMA_COLS * 8)
STARWARS_BOOTSTRAP = $c000
STARWARS_GO = $9fcc

!ifndef START_MODE {
START_MODE      = MODE_MENU
}

SCREEN          = $0400
COLOR_RAM       = $d800
BITMAP          = $4000
BITMAP_SCREEN   = $6000
HIRES_CHARSET   = $2800
METALUX_CHARSET = $3000
SPRITES         = $3800
SPRITES_PTR     = SPRITES / $40

* = $0801
!byte $0c,$08,$0a,$00,$9e
!text "2061"
!byte $00,$00,$00

* = $080d
entry:
    sei
    ldx #$ff
    txs
    lda #$7f
    sta $dc0d
    sta $dd0d
    lda $dc0d
    lda $dd0d
    lda #$00
    sta $d01a
    lda #$ff
    sta $d019
    lda #$35
    sta $01

    lda #START_MODE
    sta mode
    lda #$00
    sta key_lock
    sta frame_counter
    sta plasma_x_phase
    sta plasma_y_phase
    sta menu_pulse

!if START_MODE = MODE_MENU {
    jsr init_menu
}
!if START_MODE = MODE_METALUX {
    jsr init_metalux
}
!if START_MODE = MODE_PV_FADE {
    jsr init_pv_fade
}
!if START_MODE = MODE_BITMAP {
    jsr init_bitmap
}
!if START_MODE = MODE_HIRES {
    jsr init_hires
}
!if START_MODE = MODE_RAZOR_PLASMA {
    jsr init_razor_plasma
}
!if START_MODE = MODE_STARWARS {
    jsr init_starwars
}

main_loop:
    jsr wait_frame
    inc frame_counter
    jsr scan_keys
    jsr handle_keys
    lda mode
    bne mode_not_menu
    jmp update_menu
mode_not_menu:
    cmp #MODE_METALUX
    bne mode_not_metalux
    jmp update_metalux
mode_not_metalux:
    cmp #MODE_PV_FADE
    bne mode_not_pv_fade
    jmp update_pv_fade
mode_not_pv_fade:
    cmp #MODE_BITMAP
    bne mode_not_bitmap
    jmp update_bitmap
mode_not_bitmap:
    cmp #MODE_HIRES
    bne mode_check_extra
    jmp update_hires
mode_check_extra:
    cmp #MODE_RAZOR_PLASMA
    bne mode_not_razor_plasma
    jmp update_razor_plasma
mode_not_razor_plasma:
    cmp #MODE_STARWARS
    bne mode_fallthrough
    jmp update_starwars
mode_fallthrough:
    jmp main_loop

update_menu:
    lda frame_counter
    lsr
    lsr
    and #$07
    tax
    lda menu_colors, x
    sta $d020
    lda #$06
    sta $d021
    jmp main_loop

handle_keys:
    lda key_code
    beq handle_keys_done
    cmp #$20
    bne not_space
    lda mode
    beq handle_keys_done
    jsr init_menu
    lda #MODE_MENU
    sta mode
    jmp handle_keys_done
not_space:
    cmp #$01
    bne not_1
    lda #MODE_METALUX
    sta mode
    jsr init_metalux
    jmp handle_keys_done
not_1:
    cmp #$02
    bne not_2
    lda #MODE_PV_FADE
    sta mode
    jsr init_pv_fade
    jmp handle_keys_done
not_2:
    cmp #$03
    bne not_3
    lda #MODE_BITMAP
    sta mode
    jsr init_bitmap
    jmp handle_keys_done
not_3:
    cmp #$04
    bne not_4
    lda #MODE_HIRES
    sta mode
    jsr init_hires
    jmp handle_keys_done
not_4:
    cmp #$05
    bne not_5
    lda #MODE_RAZOR_PLASMA
    sta mode
    jsr init_razor_plasma
    jmp handle_keys_done
not_5:
    cmp #$06
    bne handle_keys_done
    lda #MODE_STARWARS
    sta mode
    jsr init_starwars
handle_keys_done:
    rts

wait_frame:
wf0:
    lda $d012
    cmp #$f8
    bne wf0
wf1:
    lda $d012
    cmp #$f8
    beq wf1
    rts

scan_keys:
    lda #$00
    sta key_code

    lda #$7f
    sta $dc00
    lda $dc01
    and #%00000001
    bne sk_no_1
    lda #$02
    sta key_code
sk_no_1:
    lda key_code
    bne sk_have
    lda $dc01
    and #%00001000
    bne sk_no_2
    lda #$02
    sta key_code
sk_no_2:
    lda key_code
    bne sk_have
    lda $dc01
    and #%00010000
    bne sk_row1
    lda #$20
    sta key_code
    jmp sk_have

sk_row1:
    lda #$fd
    sta $dc00
    lda $dc01
    and #%00000001
    bne sk_no_3
    lda #$03
    sta key_code
sk_no_3:
    lda key_code
    bne sk_have
    lda $dc01
    and #%00001000
    bne sk_row2
    lda #$04
    sta key_code
    jmp sk_have

sk_row2:
    lda #$fb
    sta $dc00
    lda $dc01
    and #%00000001
    bne sk_no_5
    lda #$05
    sta key_code
sk_no_5:
    lda key_code
    bne sk_have
    lda $dc01
    and #%00001000
    bne sk_have
    lda #$06
    sta key_code

sk_have:
    lda #$ff
    sta $dc00
    lda key_code
    bne sk_pressed
    lda #$00
    sta key_lock
    rts
sk_pressed:
    lda key_lock
    beq sk_new
    lda #$00
    sta key_code
    rts
sk_new:
    lda #$01
    sta key_lock
    rts

init_menu:
    jsr disable_raster_irq
    lda $dd00
    and #%11111100
    ora #%00000011
    sta $dd00
    lda #$1b
    sta $d011
    lda #$08
    sta $d016
    lda #$14
    sta $d018
    lda #$00
    sta $d015
    lda #$20
    jsr clear_text_screen
    lda #$0e
    jsr fill_color_ram

    lda #<menu_title
    sta txt_ptr
    lda #>menu_title
    sta txt_ptr+1
    lda #<$0450
    sta scr_ptr
    lda #>$0450
    sta scr_ptr+1
    jsr write_text

    lda #<menu_line_1
    sta txt_ptr
    lda #>menu_line_1
    sta txt_ptr+1
    lda #<$04c8
    sta scr_ptr
    lda #>$04c8
    sta scr_ptr+1
    jsr write_text

    lda #<menu_line_2
    sta txt_ptr
    lda #>menu_line_2
    sta txt_ptr+1
    lda #<$0518
    sta scr_ptr
    lda #>$0518
    sta scr_ptr+1
    jsr write_text

    lda #<menu_line_3
    sta txt_ptr
    lda #>menu_line_3
    sta txt_ptr+1
    lda #<$0568
    sta scr_ptr
    lda #>$0568
    sta scr_ptr+1
    jsr write_text

    lda #<menu_line_4
    sta txt_ptr
    lda #>menu_line_4
    sta txt_ptr+1
    lda #<$05b8
    sta scr_ptr
    lda #>$05b8
    sta scr_ptr+1
    jsr write_text

    lda #<menu_line_5
    sta txt_ptr
    lda #>menu_line_5
    sta txt_ptr+1
    lda #<$0608
    sta scr_ptr
    lda #>$0608
    sta scr_ptr+1
    jsr write_text

    lda #<menu_line_6
    sta txt_ptr
    lda #>menu_line_6
    sta txt_ptr+1
    lda #<$0658
    sta scr_ptr
    lda #>$0658
    sta scr_ptr+1
    jsr write_text

    lda #<menu_footer_1
    sta txt_ptr
    lda #>menu_footer_1
    sta txt_ptr+1
    lda #<$06a8
    sta scr_ptr
    lda #>$06a8
    sta scr_ptr+1
    jsr write_text

    lda #<menu_footer_2
    sta txt_ptr
    lda #>menu_footer_2
    sta txt_ptr+1
    lda #<$06d0
    sta scr_ptr
    lda #>$06d0
    sta scr_ptr+1
    jsr write_text

    lda #$06
    sta $d021
    lda #$0e
    sta $d020
    rts

clear_text_screen:
    ldx #$00
cts_loop:
    sta SCREEN, x
    sta SCREEN+$100, x
    sta SCREEN+$200, x
    sta SCREEN+$2e8, x
    inx
    bne cts_loop
    rts

fill_color_ram:
    ldx #$00
fcr_loop:
    sta COLOR_RAM, x
    sta COLOR_RAM+$100, x
    sta COLOR_RAM+$200, x
    sta COLOR_RAM+$2e8, x
    inx
    bne fcr_loop
    rts

write_text:
    ldy #$00
wt_loop:
    lda (txt_ptr), y
    beq wt_done
    sta (scr_ptr), y
    iny
    bne wt_loop
wt_done:
    rts

init_metalux:
    jsr disable_raster_irq
    lda $dd00
    and #%11111100
    ora #%00000011
    sta $dd00
    lda #$1b
    sta $d011
    lda #$18
    sta $d016
    lda #$1c
    sta $d018
    lda #$00
    sta $d015
    lda #$00
    jsr clear_text_screen
    lda #$06
    jsr fill_color_ram
    lda #$00
    sta plasma_x_phase
    sta plasma_y_phase
    sta $d020
    lda #$06
    sta $d021
    rts

update_metalux:
    jsr build_metalux_buffers

    lda #<SCREEN
    sta scr_ptr
    lda #>SCREEN
    sta scr_ptr+1
    lda #<COLOR_RAM
    sta col_ptr
    lda #>COLOR_RAM
    sta col_ptr+1
    lda #$00
    sta row_counter

metalux_row_loop:
    ldy row_counter
    lda metalux_ybuf, y
    sta tmp0
    ldy #$00
metalux_col_loop:
    lda metalux_xbuf, y
    clc
    adc tmp0
    lsr
    lsr
    lsr
    lsr
    tax
    lda metalux_ramp, x
    sta (scr_ptr), y
    lda metalux_palette, x
    sta (col_ptr), y
    iny
    cpy #40
    bne metalux_col_loop

    clc
    lda scr_ptr
    adc #40
    sta scr_ptr
    bcc metalux_scr_ok
    inc scr_ptr+1
metalux_scr_ok:
    clc
    lda col_ptr
    adc #40
    sta col_ptr
    bcc metalux_col_ok
    inc col_ptr+1
metalux_col_ok:
    inc row_counter
    lda row_counter
    cmp #25
    bne metalux_row_loop

    dec plasma_x_phase
    inc plasma_y_phase
    jmp main_loop

build_metalux_buffers:
    ldx #$00
metalux_xbuf_loop:
    lda plasma_x_phase
    clc
    adc metalux_xofs_a, x
    tay
    lda metalux_sin, y
    sta tmp0
    lda plasma_y_phase
    clc
    adc metalux_xofs_b, x
    tay
    lda metalux_sin, y
    clc
    adc tmp0
    sta metalux_xbuf, x
    inx
    cpx #40
    bne metalux_xbuf_loop

    ldx #$00
metalux_ybuf_loop:
    lda plasma_x_phase
    clc
    adc metalux_yofs_a, x
    tay
    lda metalux_sin, y
    sta tmp0
    lda plasma_y_phase
    clc
    adc metalux_yofs_b, x
    tay
    lda metalux_sin, y
    clc
    adc tmp0
    sta metalux_ybuf, x
    inx
    cpx #25
    bne metalux_ybuf_loop
    rts

init_bitmap_mode:
    jsr disable_raster_irq
    lda $dd00
    and #%11111100
    ora #%00000010
    sta $dd00
    lda #$3b
    sta $d011
    lda #$18
    sta $d016
    lda #$80
    sta $d018
    lda #$00
    sta $d015
    lda #$00
    sta $d020
    sta $d021
    rts

init_pv_fade:
    jsr init_bitmap_mode
    jsr clear_razor_left_map
    lda #$00
    jsr clear_bitmap_screen
    jsr clear_bitmap_colors
    lda #$00
    sta reveal_step
    sta effect_timer
    rts

update_pv_fade:
    inc effect_timer
    lda effect_timer
    and #$01
    bne pv_fade_done
    lda reveal_step
    cmp #20
    bcs pv_fade_hold
    tax
    lda pv_left_columns, x
    sta tmp1
    lda pv_right_columns, x
    sta tmp2
    jsr copy_bitmap_column_pair
    inc reveal_step
    jmp pv_fade_done
pv_fade_hold:
    lda frame_counter
    lsr
    lsr
    and #$07
    tax
    lda menu_colors, x
    sta $d020
pv_fade_done:
    jmp main_loop

init_bitmap:
    jsr init_bitmap_mode
    jsr clear_razor_left_map
    jsr copy_full_bitmap_screen
    jsr copy_full_bitmap_colors
    lda #$00
    sta effect_timer
    rts

update_bitmap:
    lda frame_counter
    lsr
    lsr
    and #$07
    tax
    lda bitmap_border_colors, x
    sta $d020
    jmp main_loop

init_razor_plasma:
    jsr init_bitmap_mode
    jsr copy_combined_left_map
    jsr copy_full_bitmap_screen
    jsr copy_full_bitmap_colors
    lda #$00
    sta razor_phase
    sta $d020
    sta $d021
    rts

update_razor_plasma:
    lda #<BITMAP_SCREEN
    sta scr_ptr
    lda #>BITMAP_SCREEN
    sta scr_ptr+1
    lda #<COLOR_RAM
    sta col_ptr
    lda #>COLOR_RAM
    sta col_ptr+1
    lda #$00
    sta row_counter

razor_plasma_row:
    ldy #$00
razor_plasma_col:
    tya
    clc
    adc row_counter
    adc razor_phase
    and #$0f
    tax
    lda razor_screen_plasma, x
    sta (scr_ptr), y
    lda razor_color_plasma, x
    sta (col_ptr), y
    iny
    cpy #RAZOR_PLASMA_COLS
    bne razor_plasma_col

    clc
    lda scr_ptr
    adc #40
    sta scr_ptr
    bcc razor_plasma_scr_ok
    inc scr_ptr+1
razor_plasma_scr_ok:
    clc
    lda col_ptr
    adc #40
    sta col_ptr
    bcc razor_plasma_col_ok
    inc col_ptr+1
razor_plasma_col_ok:
    inc row_counter
    lda row_counter
    cmp #25
    bne razor_plasma_row

    inc razor_phase
    jmp main_loop

copy_combined_left_map:
    lda #<combined_map_shadow
    sta scr_ptr
    lda #>combined_map_shadow
    sta scr_ptr+1
    lda #<BITMAP
    sta col_ptr
    lda #>BITMAP
    sta col_ptr+1
    lda #25
    sta row_counter
copy_combined_row:
    ldx #RAZOR_PLASMA_COLS
copy_combined_cell:
    ldy #$00
copy_combined_byte:
    lda (scr_ptr), y
    sta (col_ptr), y
    iny
    cpy #8
    bne copy_combined_byte
    jsr advance_map_cell
    dex
    bne copy_combined_cell
    jsr advance_map_row_tail
    dec row_counter
    bne copy_combined_row
    rts

clear_razor_left_map:
    lda #<BITMAP
    sta col_ptr
    lda #>BITMAP
    sta col_ptr+1
    lda #25
    sta row_counter
clear_razor_map_row:
    ldx #RAZOR_PLASMA_COLS
clear_razor_map_cell:
    ldy #$00
    lda #$00
clear_razor_map_byte:
    sta (col_ptr), y
    iny
    cpy #8
    bne clear_razor_map_byte
    jsr advance_dest_map_cell
    dex
    bne clear_razor_map_cell
    jsr advance_dest_map_row_tail
    dec row_counter
    bne clear_razor_map_row
    rts

advance_map_cell:
    clc
    lda scr_ptr
    adc #8
    sta scr_ptr
    bcc advance_map_cell_src_ok
    inc scr_ptr+1
advance_map_cell_src_ok:
advance_dest_map_cell:
    clc
    lda col_ptr
    adc #8
    sta col_ptr
    bcc advance_map_cell_done
    inc col_ptr+1
advance_map_cell_done:
    rts

advance_map_row_tail:
    clc
    lda scr_ptr
    adc #RAZOR_PLASMA_MAP_TAIL
    sta scr_ptr
    bcc advance_map_row_src_ok
    inc scr_ptr+1
advance_map_row_src_ok:
advance_dest_map_row_tail:
    clc
    lda col_ptr
    adc #RAZOR_PLASMA_MAP_TAIL
    sta col_ptr
    bcc advance_map_row_done
    inc col_ptr+1
advance_map_row_done:
    rts

init_starwars:
    jmp STARWARS_BOOTSTRAP

load_starwars_file:
    pha
    txa
    pha
    tya
    pha
    lda #$02
    jsr KERNAL_CLOSE
    jsr KERNAL_CLRCHN
    pla
    tay
    pla
    tax
    pla
    jsr KERNAL_SETNAM
    lda #$01
    ldx #$08
    ldy #$01
    jsr KERNAL_SETLFS
    lda #$00
    tax
    tay
    jsr KERNAL_LOAD
    bcs starwars_load_error
    rts

starwars_load_error:
    sta tmp0
    lda #$35
    sta $01
    jsr init_menu
    lda #<starwars_load_error_text
    sta txt_ptr
    lda #>starwars_load_error_text
    sta txt_ptr+1
    lda #<(SCREEN+$28*19)
    sta scr_ptr
    lda #>(SCREEN+$28*19)
    sta scr_ptr+1
    jsr write_text
    lda star_load_step
    clc
    adc #$30
    sta SCREEN+$28*19+16
    lda tmp0
    clc
    adc #$30
    sta SCREEN+$28*19+18
    lda #MODE_MENU
    sta mode
    pla
    pla
    rts

update_starwars:
    jmp main_loop

copy_bitmap_column_pair:
    lda #<bitmap_screen_shadow
    clc
    adc tmp1
    sta scr_ptr
    lda #>bitmap_screen_shadow
    adc #$00
    sta scr_ptr+1
    lda #<BITMAP_SCREEN
    clc
    adc tmp1
    sta col_ptr
    lda #>BITMAP_SCREEN
    adc #$00
    sta col_ptr+1
    lda #$00
    sta row_counter
pv_left_loop:
    ldy #$00
    lda (scr_ptr), y
    sta (col_ptr), y
    clc
    lda scr_ptr
    adc #40
    sta scr_ptr
    bcc pv_left_src_ok
    inc scr_ptr+1
pv_left_src_ok:
    clc
    lda col_ptr
    adc #40
    sta col_ptr
    bcc pv_left_dst_ok
    inc col_ptr+1
pv_left_dst_ok:
    inc row_counter
    lda row_counter
    cmp #25
    bne pv_left_loop

    lda #<bitmap_color_shadow
    clc
    adc tmp1
    sta scr_ptr
    lda #>bitmap_color_shadow
    adc #$00
    sta scr_ptr+1
    lda #<COLOR_RAM
    clc
    adc tmp1
    sta col_ptr
    lda #>COLOR_RAM
    adc #$00
    sta col_ptr+1
    lda #$00
    sta row_counter
pv_left_color_loop:
    ldy #$00
    lda (scr_ptr), y
    sta (col_ptr), y
    clc
    lda scr_ptr
    adc #40
    sta scr_ptr
    bcc pv_left_col_src_ok
    inc scr_ptr+1
pv_left_col_src_ok:
    clc
    lda col_ptr
    adc #40
    sta col_ptr
    bcc pv_left_col_dst_ok
    inc col_ptr+1
pv_left_col_dst_ok:
    inc row_counter
    lda row_counter
    cmp #25
    bne pv_left_color_loop

    lda #<bitmap_screen_shadow
    clc
    adc tmp2
    sta scr_ptr
    lda #>bitmap_screen_shadow
    adc #$00
    sta scr_ptr+1
    lda #<BITMAP_SCREEN
    clc
    adc tmp2
    sta col_ptr
    lda #>BITMAP_SCREEN
    adc #$00
    sta col_ptr+1
    lda #$00
    sta row_counter
pv_right_loop:
    ldy #$00
    lda (scr_ptr), y
    sta (col_ptr), y
    clc
    lda scr_ptr
    adc #40
    sta scr_ptr
    bcc pv_right_src_ok
    inc scr_ptr+1
pv_right_src_ok:
    clc
    lda col_ptr
    adc #40
    sta col_ptr
    bcc pv_right_dst_ok
    inc col_ptr+1
pv_right_dst_ok:
    inc row_counter
    lda row_counter
    cmp #25
    bne pv_right_loop

    lda #<bitmap_color_shadow
    clc
    adc tmp2
    sta scr_ptr
    lda #>bitmap_color_shadow
    adc #$00
    sta scr_ptr+1
    lda #<COLOR_RAM
    clc
    adc tmp2
    sta col_ptr
    lda #>COLOR_RAM
    adc #$00
    sta col_ptr+1
    lda #$00
    sta row_counter
pv_right_color_loop:
    ldy #$00
    lda (scr_ptr), y
    sta (col_ptr), y
    clc
    lda scr_ptr
    adc #40
    sta scr_ptr
    bcc pv_right_col_src_ok
    inc scr_ptr+1
pv_right_col_src_ok:
    clc
    lda col_ptr
    adc #40
    sta col_ptr
    bcc pv_right_col_dst_ok
    inc col_ptr+1
pv_right_col_dst_ok:
    inc row_counter
    lda row_counter
    cmp #25
    bne pv_right_color_loop
    rts

clear_bitmap_screen:
    ldx #$00
cbs_loop:
    sta BITMAP_SCREEN, x
    sta BITMAP_SCREEN+$100, x
    sta BITMAP_SCREEN+$200, x
    sta BITMAP_SCREEN+$2e8, x
    inx
    bne cbs_loop
    rts

clear_bitmap_colors:
    ldx #$00
cbc_loop:
    sta COLOR_RAM, x
    sta COLOR_RAM+$100, x
    sta COLOR_RAM+$200, x
    sta COLOR_RAM+$2e8, x
    inx
    bne cbc_loop
    rts

copy_full_bitmap_screen:
    ldx #$00
cfbs_loop:
    lda bitmap_screen_shadow, x
    sta BITMAP_SCREEN, x
    lda bitmap_screen_shadow+$100, x
    sta BITMAP_SCREEN+$100, x
    lda bitmap_screen_shadow+$200, x
    sta BITMAP_SCREEN+$200, x
    lda bitmap_screen_shadow+$2e8, x
    sta BITMAP_SCREEN+$2e8, x
    inx
    bne cfbs_loop
    rts

copy_full_bitmap_colors:
    ldx #$00
cfbc_loop:
    lda bitmap_color_shadow, x
    sta COLOR_RAM, x
    lda bitmap_color_shadow+$100, x
    sta COLOR_RAM+$100, x
    lda bitmap_color_shadow+$200, x
    sta COLOR_RAM+$200, x
    lda bitmap_color_shadow+$2e8, x
    sta COLOR_RAM+$2e8, x
    inx
    bne cfbc_loop
    rts

init_hires:
    jsr disable_raster_irq
    lda $dd00
    and #%11111100
    ora #%00000011
    sta $dd00
    lda #$1b
    sta $d011
    lda #$c8
    sta $d016
    lda #$1a
    sta $d018
    lda #$00
    sta $d020
    sta $d021
    lda #$00
    jsr clear_text_screen
    lda #$0c
    jsr fill_color_ram
    jsr draw_hires_background
    jsr init_hires_sprites
    lda #$00
    sta column_dir
    sta effect_timer
    lda #$00
    sta column_phase
    lda #$2f
    sta column_left_y
    lda #$40
    sta column_right_y
    jsr reposition_hires_trails
    rts

draw_hires_background:
    lda #<SCREEN
    sta scr_ptr
    lda #>SCREEN
    sta scr_ptr+1
    lda #$00
    sta row_counter
hires_bg_row:
    ldx #$00
    ldy #$00
hires_bg_col:
    lda hires_row_clear, x
    sta (scr_ptr), y
    inx
    cpx #5
    bne hires_bg_no_wrap
    ldx #$00
hires_bg_no_wrap:
    iny
    cpy #40
    bne hires_bg_col
    clc
    lda scr_ptr
    adc #40
    sta scr_ptr
    bcc hires_bg_row_ok
    inc scr_ptr+1
hires_bg_row_ok:
    inc row_counter
    lda row_counter
    cmp #25
    bne hires_bg_row

    ldx #$00
    ldy #$00
hires_hline:
    lda hires_row_horizontal, y
    sta SCREEN+$28*4, x
    sta SCREEN+$28*8, x
    sta SCREEN+$28*12, x
    sta SCREEN+$28*16, x
    sta SCREEN+$28*20, x
    iny
    cpy #5
    bne hires_hline_nowrap
    ldy #$00
hires_hline_nowrap:
    inx
    cpx #40
    bne hires_hline
    rts

init_hires_sprites:
    lda #$00
    sta $d01c
    sta $d01d
    sta $d017
    lda #$ff
    sta $d01b
    sta $d015

    lda #SPRITES_PTR
    sta SCREEN+$03f8
    lda #SPRITES_PTR+1
    sta SCREEN+$03f9
    sta SCREEN+$03fa
    sta SCREEN+$03fb
    sta SCREEN+$03fc
    sta SCREEN+$03fd
    sta SCREEN+$03fe
    lda #SPRITES_PTR+2
    sta SCREEN+$03ff

    lda #$00
    sta $d010

    lda #$97
    sta $d000
    sta $d002
    sta $d004
    sta $d006
    lda #$c7
    sta $d008
    sta $d00a
    sta $d00c
    sta $d00e

    ldx #$00
hires_sprite_colors:
    lda #$0c
    sta $d027, x
    inx
    cpx #8
    bne hires_sprite_colors
    rts

update_hires:
    lda column_phase
    tax
    lda hires_accel, x
    sta tmp0
    lda #$40
    sec
    sbc tmp0
    sta column_left_y
    lda #$40
    clc
    adc tmp0
    sta column_right_y
    jsr reposition_hires_trails

    lda column_dir
    beq hires_phase_down
    dec column_phase
    lda column_phase
    bne hires_done
    lda #$00
    sta column_dir
    beq hires_done
hires_phase_down:
    inc column_phase
    lda column_phase
    cmp #23
    bcc hires_done
    lda #$01
    sta column_dir
hires_done:
    jmp main_loop

reposition_hires_trails:
    ldx #$00
    lda column_left_y
    sta tmp0
    ldy #$00
hires_left_y:
    lda tmp0
    sta $d001, x
    clc
    adc #21
    sta tmp0
    inx
    inx
    iny
    cpy #4
    bne hires_left_y

    ldx #$00
    lda column_right_y
    sta tmp0
    ldy #$00
hires_right_y:
    lda tmp0
    sta $d009, x
    clc
    adc #21
    sta tmp0
    inx
    inx
    iny
    cpy #4
    bne hires_right_y
    rts

disable_raster_irq:
    sei
    lda #$00
    sta $d01a
    lda #$ff
    sta $d019
    rts

