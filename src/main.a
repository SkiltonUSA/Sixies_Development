; Wide Borders Framework
; Static RetroDNA multicolour bitmap centered on screen with lower-border opening.

!to "build/wide_borders_framework.prg", cbm

frame_flag       = $02
frame_counter    = $03
current_bg_color = $04

vic_bank_value   = $03          ; bank 0: $0000-$3fff
bitmap_mode_25   = $3b          ; bitmap mode, 25 rows
bitmap_mode_24   = $33          ; bitmap mode, 24 rows
bitmap_d018      = $38          ; screen=$0c00, bitmap=$2000 within bank 0
                                ; (screen must avoid $1000-$1fff: VIC sees char ROM there in bank 0)
bitmap_d016      = $18          ; 40 columns, multicolour bitmap mode
top_irq_line     = $00
border_irq_line  = 249
default_bg_color = $00

; ---- BASIC stub: SYS 2061 ($080d) ----
* = $0801
!byte $0c, $08, $0a, $00, $9e
!text "2061"
!byte $00, $00, $00

* = $080d
entry:
    sei
    lda #$7f
    sta $dc0d
    sta $dd0d
    lda $dc0d
    lda $dd0d

    lda #$00
    sta frame_flag
    sta frame_counter

    lda #bitmap_mode_25
    sta $d011
    lda #bitmap_d016
    sta $d016
    lda #bitmap_d018
    sta $d018
    lda $dd00
    ora #vic_bank_value
    sta $dd00
    lda #$3b
    sta $dd02

    lda #default_bg_color
    jsr set_bg_color
    jsr copy_color_ram
    jsr hide_sprites
    jsr init_irq

main:
    lda frame_flag
    beq main
    lda #$00
    sta frame_flag
    jmp main

set_bg_color:
    sta current_bg_color
    sta $d020
    sta $d021
    rts

; The generated colour table lives in ordinary RAM so PRG loading never
; crosses the I/O area. Copy its 1,000 nybbles into colour RAM at startup.
copy_color_ram:
    ldx #$00
copy_color_pages:
    lda retrodna_color_source,x
    sta $d800,x
    lda retrodna_color_source+$100,x
    sta $d900,x
    lda retrodna_color_source+$200,x
    sta $da00,x
    inx
    bne copy_color_pages

    ldx #$00
copy_color_tail:
    lda retrodna_color_source+$300,x
    sta $db00,x
    inx
    cpx #$e8
    bne copy_color_tail
    rts

hide_sprites:
    lda #$00
    sta $d015
    sta $d010
    sta $d01c
    sta $d017
    sta $d01d
    rts

apply_border_sprite_state:
    rts

; ---- split IRQ: top-of-frame bookkeeping plus lower-border opening ----
init_irq:
    lda #$35
    sta $01
    lda #<nmi_handler
    sta $fffa
    lda #>nmi_handler
    sta $fffb
    lda #<irq_top
    sta $fffe
    lda #>irq_top
    sta $ffff
    lda #top_irq_line
    sta $d012
    lda $d011
    and #$7f
    sta $d011
    lda #$01
    sta $d01a
    sta $d019
    cli
    rts

nmi_handler:
    rti

irq_top:
    pha
    txa
    pha
    tya
    pha
    lda current_bg_color
    sta $d020
    sta $d021
    lda #$01
    sta $d019
    inc frame_counter
    lda #$01
    sta frame_flag
    lda #border_irq_line
    sta $d012
    lda #<irq_main
    sta $fffe
    lda #>irq_main
    sta $ffff
    pla
    tay
    pla
    tax
    pla
    rti

irq_main:
    pha
    txa
    pha
    tya
    pha
    lda current_bg_color
    sta $d020
    lda #$ff
    sta $d019
    jsr apply_border_sprite_state
    lda #bitmap_mode_24
    sta $d011
wait_border_open:
    lda $d012
    cmp #252
    bcc wait_border_open
    lda #bitmap_mode_25
    sta $d011
    lda #top_irq_line
    sta $d012
    lda #<irq_top
    sta $fffe
    lda #>irq_top
    sta $ffff
    pla
    tay
    pla
    tax
    pla
    rti

!source "src/generated/retrodna_multicolor.inc"
