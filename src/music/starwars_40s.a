; Looping three-voice SID arrangement derived from a MIDI transcription.
; scripts/generate_midi_markov_sid.py supplies a closed order-2 Markov phrase.
; Voice 1: PWM lead. Voice 2: filtered arpeggio.
; Voice 3: triangle bass/kick switching to pitched-noise snare.

!to "build/better-off-alone-markov.prg", cbm

!source "src/generated/better_off_alone.inc"

TIMBRE_FRAMES = 200
SNARE_PITCH = 125
IMPACT_PITCH = 126

frame_lo = $f7
frame_hi = $f8
event_byte = $f9

lead_attack = $13f0
lead_freq_lo = $13f1
lead_freq_hi = $13f2
impact_age = $13f3
loop_frame = $13f4

* = $0801
!byte $0c,$08,$0a,$00,$9e
!text "2061"
!byte $00,$00,$00

* = $080d
standalone_entry:
    sei
    jsr remains_init

standalone_wait:
    lda $d012
    cmp #$f8
    bne standalone_wait
standalone_wait_end:
    lda $d012
    cmp #$f8
    beq standalone_wait_end
    jsr remains_play
    jmp standalone_wait

* = $1000
remains_init:
    lda #$00
    sta frame_lo
    sta frame_hi
    sta lead_attack
    sta lead_freq_lo
    sta lead_freq_hi
    sta impact_age
    sta loop_frame

    ldx #$18
clear_sid:
    sta $d400,x
    dex
    bpl clear_sid

    ; Pulse widths start near 50 percent.  Voice 1 is modulated every frame;
    ; voice 2 uses a pure saw and voice 3 a pure triangle/noise waveform.
    lda #$00
    sta $d402
    sta $d409
    sta $d410
    lda #$08
    sta $d403
    sta $d40a
    sta $d411

    lda #$08                    ; immediate attack, broad cinematic decay
    sta $d405
    lda #$a7
    sta $d406
    lda #$03                    ; crisp arpeggio envelope
    sta $d40c
    lda #$53
    sta $d40d
    lda #$03                    ; weighty triangle bass
    sta $d413
    lda #$83
    sta $d414

    lda #$42                    ; resonance 4, only voice 2 through filter
    sta $d417
    lda #$1f                    ; low-pass enabled, full master volume
    sta $d418
    rts

* = $1080
remains_play:
    lda frame_hi
    cmp #>BETTER_LOOP_FRAMES
    bcc render_frame
    bne restart_sequence
    lda frame_lo
    cmp #<BETTER_LOOP_FRAMES
    bcc render_frame

restart_sequence:
    lda #$00
    sta frame_lo
    sta frame_hi
    jmp render_frame
play_done:
    rts

render_frame:
    lda frame_lo
    clc
    adc #<lead_frames
    sta lead_read+1
    lda frame_hi
    adc #>lead_frames
    sta lead_read+2
lead_read:
    lda lead_frames
    jsr update_lead

    lda frame_lo
    clc
    adc #<arp_frames
    sta arp_read+1
    lda frame_hi
    adc #>arp_frames
    sta arp_read+2
arp_read:
    lda arp_frames
    jsr update_arp

    lda frame_lo
    clc
    adc #<bass_frames
    sta bass_read+1
    lda frame_hi
    adc #>bass_frames
    sta bass_read+2
bass_read:
    lda bass_frames
    jsr update_bass
    jsr update_timbre

    inc loop_frame
    lda loop_frame
    cmp #TIMBRE_FRAMES
    bcc increment_song_frame
    lda #$00
    sta loop_frame
increment_song_frame:
    inc frame_lo
    bne play_done
    inc frame_hi
    rts

* = $1100
update_lead:
    sta event_byte
    beq lead_off
    bpl lead_frequency
    lda #$40                    ; gate off for a complete hard-restart frame
    sta $d404
    lda #$01
    sta lead_attack
lead_frequency:
    lda event_byte
    and #$7f
    tay
    lda sid_freq_lo,y
    sta lead_freq_lo
    sta $d400
    lda sid_freq_hi,y
    sta lead_freq_hi
    sta $d401

    lda event_byte
    bmi lead_done
    lda lead_attack
    beq lead_pulse
    dec lead_attack
    lda #$23                    ; one-frame oscillator-synced saw transient
    sta $d404
    rts
lead_pulse:
    lda #$41                    ; PWM pulse lead
    sta $d404
lead_done:
    rts
lead_off:
    lda #$40
    sta $d404
    lda #$00
    sta lead_attack
    rts

update_arp:
    sta event_byte
    beq arp_off
    bpl arp_frequency
    lda #$20                    ; hard restart, pure saw waveform
    sta $d40b
arp_frequency:
    lda event_byte
    and #$7f
    tay
    lda sid_freq_lo,y
    sta $d407
    lda sid_freq_hi,y
    sta $d408
    lda event_byte
    bmi arp_done
    lda #$21
    sta $d40b
arp_done:
    rts
arp_off:
    lda #$20
    sta $d40b
    rts

update_bass:
    sta event_byte
    bne bass_has_event
    jmp bass_off
bass_has_event:
    lda event_byte
    and #$7f
    cmp #SNARE_PITCH
    beq bass_snare
    cmp #IMPACT_PITCH
    beq bass_impact
    lda event_byte
    bpl bass_frequency
    lda #$10                    ; triangle gate off for hard restart
    sta $d412
    lda #$03
    sta $d413
    lda #$83
    sta $d414
    lda #$00
    sta impact_age
bass_frequency:
    lda event_byte
    and #$7f
    tay
    lda sid_freq_lo,y
    sta $d40e
    lda sid_freq_hi,y
    sta $d40f
    lda event_byte
    bmi bass_done
    lda #$11                    ; clean, solid triangle bass
    sta $d412
bass_done:
    rts

bass_snare:
    lda event_byte
    bpl snare_frequency
    lda #$80                    ; noise gate off for hard restart
    sta $d412
    lda #$08                    ; longer decay than the cinematic impact
    sta $d413
    lda #$82
    sta $d414
snare_frequency:
    lda #$00
    sta $d40e
    lda #$38                    ; bright, pitched SID noise
    sta $d40f
    lda event_byte
    bmi bass_done
    lda #$81
    sta $d412
    rts

bass_impact:
    lda event_byte
    bpl impact_frequency
    lda #$80                    ; noise gate off before the impact
    sta $d412
    lda #$00
    sta $d413
    lda #$f2                    ; full-level sustain for a forceful short hit
    sta $d414
    lda #$08
    sta impact_age
impact_frequency:
    ldx impact_age
    lda impact_freq_lo,x
    sta $d40e
    lda impact_freq_hi,x
    sta $d40f
    lda event_byte
    bmi bass_done
    lda #$81
    sta $d412
    lda impact_age
    beq bass_done
    dec impact_age
    rts

bass_off:
    lda #$10
    sta $d412
    rts

update_timbre:
    ; Slow PWM and a four-second filter cycle add movement without changing
    ; the Markov-generated pitches or note timing.
    lda loop_frame
    lsr
    lsr
    and #$1f
    tax
    lda pulse_lo,x
    sta $d402
    lda pulse_hi,x
    sta $d403

    lda loop_frame
    lsr
    lsr
    lsr
    tax
    lda filter_cutoff,x
    sta $d416
    lda loop_frame
    and #$07
    sta $d415

    ; An eight-frame signed vibrato animates the lead frequency.  The base
    ; note is retained separately so the modulation never accumulates.
    lda $d404
    and #$01
    beq timbre_done
    lda loop_frame
    and #$07
    tax
    lda vibrato_offset,x
    bpl vibrato_positive
    clc
    adc lead_freq_lo
    sta $d400
    lda lead_freq_hi
    adc #$ff
    sta $d401
    rts
vibrato_positive:
    clc
    adc lead_freq_lo
    sta $d400
    lda lead_freq_hi
    adc #$00
    sta $d401
timbre_done:
    rts

pulse_lo:
    !byte $00,$40,$80,$c0,$00,$40,$80,$c0
    !byte $00,$40,$80,$c0,$00,$40,$80,$c0
    !byte $00,$c0,$80,$40,$00,$c0,$80,$40
    !byte $00,$c0,$80,$40,$00,$c0,$80,$40
pulse_hi:
    !byte $05,$05,$05,$05,$06,$06,$06,$06
    !byte $07,$07,$07,$07,$08,$08,$08,$08
    !byte $09,$09,$09,$09,$08,$08,$08,$08
    !byte $07,$07,$07,$07,$06,$06,$06,$06

vibrato_offset:
    !byte $00,$03,$06,$03,$00,$fd,$fa,$fd

; 25 entries: loop_frame / 8 ranges from 0 through 24.
filter_cutoff:
    !byte $18,$1c,$22,$2a,$34,$40,$4e,$5e,$70,$82
    !byte $94,$a6,$b8,$c8,$d4,$dc,$c8,$ae,$92,$76
    !byte $5e,$48,$38,$2a,$20

; Index 8 starts high and descends as impact_age counts down.
impact_freq_lo:
    !byte $00,$20,$40,$60,$80,$a0,$c0,$e0,$00
impact_freq_hi:
    !byte $10,$14,$18,$1e,$26,$30,$3c,$4a,$58

* = $1400
!source "src/generated/sid_pal_freq.inc"

* = $1800
lead_frames:
!bin "src/music/better_off_alone_frames.bin", BETTER_LOOP_FRAMES, 0

* = $1980
arp_frames:
!bin "src/music/better_off_alone_frames.bin", BETTER_LOOP_FRAMES, BETTER_LOOP_FRAMES

* = $1b00
bass_frames:
!bin "src/music/better_off_alone_frames.bin", BETTER_LOOP_FRAMES, BETTER_LOOP_FRAMES * 2

!if remains_init != $1000 {
    !error "PSID init address changed; update scripts/package_sid.py"
}
!if remains_play != $1080 {
    !error "PSID play address changed; update scripts/package_sid.py"
}
