; Three-voice SID arrangement based on the first 40 seconds of the supplied MP3.
; The frame data is hand-arranged by scripts/generate_starwars_sid_frames.py.
; No NoBounds music data is used here.
; The playback engine renders it as an original mid-1980s C64 soundtrack
; arrangement with PWM, bends, arpeggios, noise percussion, and filter sweeps.

!to "build/star-wars-40s.prg", cbm

PAL_FRAMES = 2000

frame_lo = $f7
frame_hi = $f8
event_byte = $f9
stopped = $fa
arp_pitch = $fb
lead_bend = $fc

* = $0801
!byte $0c,$08,$0a,$00,$9e
!text "2061"
!byte $00,$00,$00

* = $080d
standalone_entry:
    sei
    jsr sid40_init

standalone_wait:
    lda $d012
    cmp #$f8
    bne standalone_wait
standalone_wait_end:
    lda $d012
    cmp #$f8
    beq standalone_wait_end
    jsr sid40_play
    jmp standalone_wait

* = $1000
sid40_init:
    lda #$00
    sta frame_lo
    sta frame_hi
    sta stopped
    sta lead_bend

    ldx #$18
clear_sid:
    sta $d400,x
    dex
    bpl clear_sid

    lda #$00
    sta $d402
    sta $d409
    sta $d410
    lda #$08
    sta $d403
    sta $d40a
    sta $d411

    lda #$09                    ; hard lead attack, ringing decay
    sta $d405
    lda #$b6                    ; bright sustain, audible release
    sta $d406
    lda #$06
    sta $d40c
    lda #$74
    sta $d40d
    lda #$02
    sta $d413
    lda #$92
    sta $d414

    lda #$46                    ; resonance 4, route voices 2 and 3 to filter
    sta $d417
    lda #$1f                    ; low-pass filter, maximum volume
    sta $d418
    rts

* = $1080
sid40_play:
    lda stopped
    bne play_done
    lda frame_hi
    cmp #>PAL_FRAMES
    bcc render_frame
    bne stop_music
    lda frame_lo
    cmp #<PAL_FRAMES
    bcc render_frame

stop_music:
    jsr silence_voices
    lda #$01
    sta stopped
play_done:
    rts

render_frame:
    lda frame_lo
    clc
    adc #<lead_frames
    sta lead_read+1
    lda frame_hi
    adc #>lead_frames
    sta lead_read+2
lead_read:
    lda lead_frames
    jsr update_lead

    lda frame_lo
    clc
    adc #<harmony_frames
    sta harmony_read+1
    lda frame_hi
    adc #>harmony_frames
    sta harmony_read+2
harmony_read:
    lda harmony_frames
    jsr update_harmony

    lda frame_lo
    clc
    adc #<bass_frames
    sta bass_read+1
    lda frame_hi
    adc #>bass_frames
    sta bass_read+2
bass_read:
    lda bass_frames
    jsr update_bass
    jsr update_timbre

    inc frame_lo
    bne play_done
    inc frame_hi
    rts

* = $1100
update_lead:
    sta event_byte
    beq lead_off
    bpl lead_frequency
    lda #$40                    ; pulse wave, gate off for retrigger
    sta $d404
    lda #$06
    sta lead_bend
lead_frequency:
    lda event_byte
    and #$7f
    tay
    lda sid_freq_lo,y
    sta $d400
    lda sid_freq_hi,y
    sta $d401

    ldx lead_bend
    beq lead_bend_done
    lda $d400
    sec
    sbc bend_delta_lo,x
    sta $d400
    lda $d401
    sbc bend_delta_hi,x
    sta $d401
    dec lead_bend
lead_bend_done:

    ldx frame_lo
    txa
    and #$07
    tax
    lda vibrato_delta,x
    bmi lead_vibrato_down
    clc
    adc $d400
    sta $d400
    bcc lead_vibrato_done
    inc $d401
    jmp lead_vibrato_done
lead_vibrato_down:
    clc
    adc $d400
    sta $d400
    lda $d401
    adc #$ff
    sta $d401
lead_vibrato_done:
    lda #$41                    ; pulse wave + gate
    sta $d404
    rts
lead_off:
    lda #$40
    sta $d404
    rts

update_harmony:
    sta event_byte
    beq harmony_off
    bpl harmony_frequency
    lda #$60                    ; saw/pulse wave, gate off for retrigger
    sta $d40b
harmony_frequency:
    lda event_byte
    and #$7f
    sta arp_pitch
    lda frame_lo
    lsr
    and #$07
    tax
    lda arp_offsets,x
    clc
    adc arp_pitch
    tay
    lda sid_freq_lo,y
    sta $d407
    lda sid_freq_hi,y
    sta $d408
    lda #$61                    ; saw/pulse wave + gate
    sta $d40b
    rts
harmony_off:
    lda #$60
    sta $d40b
    rts

update_bass:
    sta event_byte
    beq bass_off
    bpl bass_frequency
    lda #$00                    ; hard restart before a noise percussion hit
    sta $d412
    sta $d40e
    lda #$20
    sta $d40f
    lda #$81                    ; one PAL frame of noise percussion
    sta $d412
    rts
bass_frequency:
    lda event_byte
    and #$7f
    sta arp_pitch
    lda frame_lo
    lsr
    lsr
    and #$03
    tax
    lda bass_offsets,x
    clc
    adc arp_pitch
    tay
    lda sid_freq_lo,y
    sta $d40e
    lda sid_freq_hi,y
    sta $d40f
    lda #$51                    ; triangle/pulse wave + gate
    sta $d412
    rts
bass_off:
    lda #$50
    sta $d412
    rts

update_timbre:
    lda frame_lo
    lsr
    lsr
    lsr
    and #$0f
    tax
    lda pulse_lo,x
    sta $d402
    lda pulse_hi,x
    sta $d403

    lda frame_lo
    lsr
    lsr
    lsr
    lsr
    and #$0f
    tax
    lda filter_cutoff,x
    sta $d416
    lda frame_lo
    and #$07
    sta $d415
    rts

silence_voices:
    lda #$00
    sta $d404
    sta $d40b
    sta $d412
    sta $d418
    rts

arp_offsets:
    !byte 0,7,12,19,12,7,0,12
bass_offsets:
    !byte 0,0,12,0
vibrato_delta:
    !byte 0,3,5,3,0,$fd,$fb,$fd
bend_delta_lo:
    !byte $00,$0a,$12,$1c,$28,$36,$46
bend_delta_hi:
    !byte $00,$00,$00,$00,$00,$00,$00
pulse_lo:
    !byte $20,$80,$e0,$40,$a0,$00,$60,$c0,$20,$c0,$60,$00,$a0,$40,$e0,$80
pulse_hi:
    !byte $04,$04,$04,$05,$05,$06,$06,$06,$07,$06,$06,$06,$05,$05,$04,$04
filter_cutoff:
    !byte $14,$1c,$28,$38,$50,$68,$82,$9c,$b4,$9c,$82,$68,$50,$38,$28,$1c

* = $1400
!source "src/generated/sid_pal_freq.inc"

* = $1800
lead_frames:
!bin "src/music/starwars_3voice_frames.bin", PAL_FRAMES, 0

* = $2000
harmony_frames:
!bin "src/music/starwars_3voice_frames.bin", PAL_FRAMES, PAL_FRAMES

* = $2800
bass_frames:
!bin "src/music/starwars_3voice_frames.bin", PAL_FRAMES, PAL_FRAMES * 2

!if sid40_init != $1000 {
    !error "PSID init address changed; update scripts/package_sid.py"
}
!if sid40_play != $1080 {
    !error "PSID play address changed; update scripts/package_sid.py"
}
